{
  "name": "baoviet-lead-cms",
  "private": true,
  "version": "1.0.63-clean.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:chatbot": "tsx --test tests/chatbot-regression.test.ts",
    "audit:chatbot": "node scripts/audit-chatbot-contracts.mjs",
    "test:chatbot:scenarios": "tsx --test tests/chatbot-scenario-simulator.test.ts",
    "test:chatbot:all": "tsx --test tests/chatbot-regression.test.ts tests/chatbot-scenario-simulator.test.ts tests/chatbot-edge-cases.test.ts tests/chatbot-adaptive-intelligence.test.ts tests/chatbot-smart-efficiency.test.ts tests/chatbot-grounded-calculation.test.ts",
    "test:chatbot:edge": "tsx --test tests/chatbot-edge-cases.test.ts",
    "test:chatbot:adaptive": "tsx --test tests/chatbot-adaptive-intelligence.test.ts",
    "test:chatbot:efficiency": "tsx --test tests/chatbot-smart-efficiency.test.ts",
    "test:chatbot:calculation": "tsx --test tests/chatbot-grounded-calculation.test.ts",
    "test:cms": "node scripts/run-tests.mjs",
    "test:site-search": "tsx --test tests/site-search.test.ts",
    "test:cloud-resilience": "node --test tests/cloud-resilience-contract.test.cjs tests/gateway-readiness.test.cjs",
    "test:message-queue": "node --test tests/message-queue-contract.test.cjs",
    "test:auth-refresh": "node --test tests/auth-refresh-rotation.test.cjs",
    "test:dirty-state": "node --test tests/dirty-state-contract.test.cjs",
    "test:chatbot:flow": "tsx --test tests/chatbot-flow-switching.test.ts",
    "test:clean-base": "node --test tests/clean-base-contract.test.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dompurify": "^3.4.16",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^13.5.0",
    "google-auth-library": "^10.9.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
