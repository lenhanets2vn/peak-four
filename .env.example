# Runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Optional persistent-data path for Railway/Render/VPS. Example: /var/data or /data
DATA_DIR=

# Gemini API key used by the customer chatbot/Copilot as the language layer over focused Notebook evidence.
# The local Case-Based Knowledge Engine remains the source of truth and can answer without the key.

# ===== GOOGLE LOGIN RBAC (optional) =====
# Google login can remain enabled in parallel with local CMS accounts.
# Production: Google-login email MUST appear in one of these allow-lists.
# Separate multiple emails with commas.
CMS_SUPERADMIN_EMAILS=admin@example.com
CMS_MARKETING_EMAILS=marketing@example.com
CMS_CONTENT_EDITOR_EMAILS=content@example.com
CMS_VIEWER_EMAILS=viewer@example.com

# ===== LOCAL CMS ACCOUNT BOOTSTRAP =====
# Use these ONLY to create the first local Super Admin on a fresh deployment.
# Once admin_users.json has been created, remove CMS_BOOTSTRAP_ADMIN_PASSWORD from cloud env.
# Username: 3-40 chars [a-z0-9._-]
# Password: minimum 10 chars, must contain letters + numbers.
CMS_BOOTSTRAP_ADMIN_USERNAME=
CMS_BOOTSTRAP_ADMIN_PASSWORD=
CMS_BOOTSTRAP_ADMIN_EMAIL=
CMS_BOOTSTRAP_ADMIN_NAME=Super Admin

# Optional legacy passcode login for controlled environments. Hidden from public login UI.
CMS_SUPERADMIN_PASSCODE=
CMS_MARKETING_PASSCODE=
CMS_CONTENT_PASSCODE=
CMS_VIEWER_PASSCODE=

# ===== FIRESTORE SERVER-SIDE PERSISTENCE =====
# Required for durable Cloud persistence on Render/Railway/VPS.
# Preferred: JSON of a Firebase/Google service account for the SAME Firebase project.
# Never put this value in frontend code or commit it to Git.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Aliases accepted for easier Render/Railway configuration.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Alternative to JSON above: base64-encoded service account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_B64=
GOOGLE_SERVICE_ACCOUNT_BASE64=
# Optional three-field form (same Service Account):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Google/Firebase managed runtimes may use Application Default Credentials automatically.

# Durable bootstrap for customer Firebase Web config on ephemeral hosts (Render).
# Recommended for production so a Render restart never depends on data/firebase_config.json.
CUSTOMER_FIREBASE_CONFIG_JSON=
# Production CMS should require Firestore persistence; keep unset to use the built-in production default.

# OPTIONAL ADVANCED AI SECRETS
# The chatbot/Copilot can use Gemini as the language layer over focused local evidence; local retrieval remains the fallback/source of truth.
AI_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
OPENAI_API_KEY=

# Optional legacy Gemini embedding quota guard. Not required by the main chatbot.
GEMINI_EMBEDDING_RPM_BUDGET=70
GEMINI_EMBEDDING_BATCH_SIZE=16

# ===== GOOGLE DOCUMENT / SHEET IMPORT =====
# For private Google Docs / Sheets links. Prefer service-account JSON on Render.
GOOGLE_DOCS_ACCESS_TOKEN=
GOOGLE_SHEETS_ACCESS_TOKEN=
GOOGLE_DOCS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_API_KEY=
# Optional: run Gemini structured summarization automatically after document import.
AI_DOCUMENT_ANALYZE_ON_IMPORT=false
GEMINI_MODEL=gemini-3.8-flash

# Optional Telegram lead/form alerts (server-side only; chatbot transcript is NOT sent to Telegram)
TELEGRAM_LEAD_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== SECURITY v1.0.42: BACKEND ONLY =====
# Production refuses startup without HTTPS URL + session key + encryption key + bridge secret.
# Generate distinct secrets; never prefix credentials with VITE_.
APP_PUBLIC_URL=
CORS_ALLOWED_ORIGINS=
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
INTERNAL_BRIDGE_SECRET=
SECRET_KEY=
# Render public TLS reverse proxy -> gateway -> private Node; enable ONLY behind that proxy.
GATEWAY_BEHIND_TLS_PROXY=true
APP_HOST=127.0.0.1
# Additional trusted proxy CIDRs only if the hosting provider documents them.
TRUSTED_PROXY_CIDRS=
CMS_ALLOW_DEV_BYPASS=false

# Upstash Redis REST (HTTPS required). Empty values use bounded runtime cache/limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_NAMESPACE=baoviet-production
GEMINI_API_KEY=

# Google Authorization Code + PKCE, server-side only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_WEBHOOK_URL=

# Set identically in Cloudflare Worker secrets and Render backend, AFTER Worker is ready.
ORIGIN_VERIFY_SECRET=

# ===== OPTIONAL CLOUD RESILIENCE TUNING (v1.0.45) =====
# Defaults are already built into the app; leave these unset unless tuning is needed.
# CLOUD_WRITE_TIMEOUT_MS=20000
# CLOUD_PUBLISH_TIMEOUT_MS=60000
# CLOUD_FULL_SYNC_TIMEOUT_MS=60000
# CLOUD_PROBE_TIMEOUT_MS=10000
# GATEWAY_PROBE_TIMEOUT_MS=5000
# GATEWAY_PROBE_INTERVAL_MS=2000
# GATEWAY_PROBE_FAILURE_THRESHOLD=3

# ===== MESSAGE QUEUE v1.0.55 (optional tuning; uses the SAME Upstash Redis above) =====
# Enabled by default when Upstash Redis is configured. No Kafka/RabbitMQ account is required.
# CLOUD_WRITE_QUEUE_ENABLED=true
# CLOUD_QUEUE_MAX_PENDING=5000
# CLOUD_QUEUE_MAX_ATTEMPTS=20
# CLOUD_QUEUE_IDLE_POLL_MS=60000
# CLOUD_QUEUE_BUSY_POLL_MS=100
# CLOUD_QUEUE_WORKER_BATCH_SIZE=8

# ===== Auth token rotation (v1.0.56, optional tuning) =====
# Access JWT ngắn hạn, mặc định 15 phút (giới hạn 5-60).
AUTH_ACCESS_TOKEN_MINUTES=15
# Refresh token family, mặc định 8 giờ (giới hạn 1-720).
AUTH_REFRESH_TOKEN_HOURS=8
# Grace cho request refresh trùng đồng thời từ cùng browser/tab-family.
# RT cũ KHÔNG sinh token mới lần 2; trong cửa sổ này chỉ trả lại cùng RT thay thế.
# Sau grace, reuse sẽ revoke toàn bộ family. Đặt 0 để strict single-use tuyệt đối.
AUTH_REFRESH_RACE_GRACE_MS=4000
